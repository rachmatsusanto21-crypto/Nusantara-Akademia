# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GAS_WEB_APP_URL: Optional deployed Google Apps Script Web App URL (https://script.google.com/macros/s/.../exec)
GAS_WEB_APP_URL=""

# ADMIN_PASSCODE: Optional preset passcode for Guru (Teacher) Dashboard login.
# If left empty, the first Guru to open the Admin Panel will claim a password securely.
ADMIN_PASSCODE=""

# SESSION_SECRET: Secret key used to sign session Bearer tokens on the server.
SESSION_SECRET=""
